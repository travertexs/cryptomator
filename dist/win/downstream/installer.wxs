<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?if $(var.Arch) = "arm64" ?>
    <?define DisplayName="Cryptomator" ?>
    <?define ShortcutName="Cryptomator" ?>
    <?define IconId="JpARPPRODUCTICON" ?>
  <?else?>
    <?define DisplayName="Cryptomator $(var.AppVersion) ($(var.Arch))" ?>
    <?define ShortcutName="Cryptomator ($(var.Arch))" ?>
    <?define IconId="CryptomatorIcon" ?>
  <?endif?>
  <Package Name="$(var.DisplayName)" Manufacturer="travertexs downstream"
           Version="$(var.Version)" UpgradeCode="$(var.UpgradeCode)" Language="1033" Scope="perMachine">
    <!-- A snapshot and its corrected build can have the same numeric MSI version. -->
    <?if $(var.Arch) = "arm64" ?>
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer Cryptomator version is already installed."/>
    <!-- Only the upstream MSI family is related. Earlier fork installations remain independent. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute"/>
    <?else?>
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer downstream version is already installed."/>
    <?endif?>
    <MediaTemplate EmbedCab="yes"/>
    <?if $(var.Arch) = "arm64" ?>
    <!-- Upstream caches the launcher's PE icon resource, not a loose ICO file. -->
    <Icon Id="$(var.IconId)" SourceFile="!(bindpath.image)\Cryptomator.exe"/>
    <?else?>
    <Icon Id="$(var.IconId)" SourceFile="dist/win/resources/Cryptomator.ico"/>
    <?endif?>
    <Property Id="ARPPRODUCTICON" Value="$(var.IconId)"/>
    <Property Id="STARTMENUSHORTCUT" Value="1" Secure="yes"/>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>
    <WixVariable Id="WixUIBannerBmp" Value="dist/win/resources/banner.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="dist/win/resources/background.bmp"/>
    <WixVariable Id="WixUILicenseRtf" Value="dist/win/resources/license.rtf"/>
    <UI>
      <Dialog Id="ShortcutPromptDlg" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="!(loc.InstallDirDlgBannerBitmap)"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="255" Height="16" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts"/>
        <Control Id="Info" Type="Text" X="25" Y="24" Width="280" Height="15" Transparent="yes" Text="Choose the shortcuts to create."/>
        <Control Id="Line" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="Menu" Type="CheckBox" X="20" Y="140" Width="305" Height="18" Property="STARTMENUSHORTCUT" CheckBoxValue="1" Text="Create a Start menu shortcut"/>
        <Control Id="Bottom" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg"/>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg"/>
        </Control>
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutPromptDlg" Order="10"/>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutPromptDlg" Condition="NOT Installed" Order="10"/>
    </UI>
    <StandardDirectory Id="ProgramFiles64Folder">
      <?if $(var.Arch) = "arm64" ?>
      <Directory Id="INSTALLFOLDER" Name="Cryptomator"/>
      <?else?>
      <Directory Id="INSTALLFOLDER" Name="Cryptomator-travertexs-$(var.Arch)"/>
      <?endif?>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <Feature Id="Complete" Title="Cryptomator" Level="1">
      <?if $(var.Arch) = "arm64" ?>
      <Component Directory="INSTALLFOLDER" Id="UpstreamRegistration" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\Skymatic GmbH\Cryptomator\$(var.Version)" Name="ProductCode" Value="[ProductCode]" Type="string" KeyPath="yes"/>
      </Component>
      <Component Directory="INSTALLFOLDER" Id="UpstreamAssociations" Guid="*">
        <File Id="VaultIcon" Source="dist/win/resources/Cryptomator-Vault.ico" KeyPath="yes"/>
        <!-- Non-advertised verbs from the official MSI. Do not alter UserChoice. -->
        <ProgId Id="progidc09ad15393a23d2fa9ebb7a73954c60b" Description="Cryptomator Vault File" Icon="VaultIcon">
          <Extension Id="cryptomator" Advertise="no" ContentType="application/vnd.cryptomator.vault">
            <MIME ContentType="application/vnd.cryptomator.vault" Default="yes"/>
            <Verb Id="open" Command="Open with Cryptomator" TargetFile="Launcher" Argument="&quot;%1&quot; %*"/>
          </Extension>
        </ProgId>
        <ProgId Id="Cryptomator.Encrypted.1" Description="Cryptomator Encrypted Data" Icon="VaultIcon">
          <Extension Id="c9r" Advertise="no" ContentType="application/vnd.cryptomator.encrypted">
            <MIME ContentType="application/vnd.cryptomator.encrypted" Default="yes"/>
          </Extension>
          <Extension Id="c9s" Advertise="no" ContentType="application/vnd.cryptomator.encrypted"/>
          <Extension Id="c9u" Advertise="no" ContentType="application/vnd.cryptomator.encrypted"/>
        </ProgId>
      </Component>
      <?endif?>
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.image)\**">
        <Exclude Files="!(bindpath.image)\Cryptomator.exe"/>
      </Files>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Id="Launcher" Source="!(bindpath.image)\Cryptomator.exe" KeyPath="yes"/>
      </Component>
      <Component Id="MenuShortcut" Directory="INSTALLFOLDER" Guid="*" Condition="STARTMENUSHORTCUT">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Target="[#Launcher]" Icon="$(var.IconId)"
                  Name="$(var.ShortcutName)" WorkingDirectory="INSTALLFOLDER"/>
        <?if $(var.Arch) = "arm64" ?>
        <RegistryValue Root="HKCU" Key="Software\Skymatic GmbH\Cryptomator\$(var.Version)" Name="ProductCode" Value="[ProductCode]" Type="string" KeyPath="yes"/>
        <?else?>
        <RegistryValue Root="HKLM" Key="Software\travertexs\Cryptomator\$(var.Arch)" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
        <?endif?>
      </Component>
    </Feature>
  </Package>
</Wix>
