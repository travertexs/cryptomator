+// This JNI DLL is not a COM server: COM cannot call DllCanUnloadNow to
+// invalidate C++/WinRT's cached factories when the last worker leaves the MTA.
+// Hold one MTA usage reference until JNI unload (or OS process cleanup).
+static std::once_flag helloMtaOnce;
+static CO_MTA_USAGE_COOKIE helloMtaUsage = nullptr;
+
+void ensureHelloMtaLifetime() {
+    std::call_once(helloMtaOnce, [] {
+        winrt::check_hresult(CoIncrementMTAUsage(&helloMtaUsage));
+    });
+}
+
+// JNI calls this before unloading the library, outside Windows' loader lock.
+// Do not perform COM initialization or teardown from DllMain/static destructors.
+extern "C" JNIEXPORT void JNICALL JNI_OnUnload(JavaVM*, void*) {
+    winrt::clear_factory_cache();
+    if (helloMtaUsage != nullptr) {
+        CoDecrementMTAUsage(helloMtaUsage);
+        helloMtaUsage = nullptr;
+    }
+}
+
+// WinRT .get() must not block an STA (including JavaFX's UI thread).
+// Keep WinRT objects on a dedicated MTA worker and return only ordinary C++ data.
+// In particular, never move a JNIEnv or Java array reference to this worker.
+template<typename F>
+auto runOnHelloThread(F&& operation) {
+    return std::async(std::launch::async, [operation = std::forward<F>(operation)]() mutable {
+        winrt::init_apartment(winrt::apartment_type::multi_threaded);
+        struct ApartmentCleanup {
+            ~ApartmentCleanup() { winrt::uninit_apartment(); }
+        } cleanup;
+        ensureHelloMtaLifetime();
+        return operation();
+    }).get();
+}
