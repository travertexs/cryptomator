+// Copy UTF-16 on the JNI caller thread; no pinned JVM buffer survives the call.
+std::wstring copyKeyIdentifier(JNIEnv* env, jbyteArray keyId) {
+    const auto bytes = jbyteArrayToVector(env, keyId);
+    if (bytes.size() < sizeof(wchar_t) || bytes.size() % sizeof(wchar_t) != 0) {
+        throw winrt::hresult_invalid_argument(L"Invalid Windows Hello key identifier");
+    }
+    std::wstring value(bytes.size() / sizeof(wchar_t), L'\0');
+    std::memcpy(value.data(), bytes.data(), bytes.size());
+    if (value.back() != L'\0') {
+        throw winrt::hresult_invalid_argument(L"Windows Hello key identifier is not terminated");
+    }
+    value.pop_back();
+    return value;
+}
